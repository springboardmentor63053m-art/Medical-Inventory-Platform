# Copy to .env and fill in only what you want to activate — the notification
# integrations below are optional and safely inactive if left unset. JWT_SECRET
# and the ADMIN_* vars are NOT optional for a real deployment (see notes below).

# REQUIRED for any real deployment: the default here (and the one baked into
# application.properties) is committed to the repo, so it can never be a safe
# production secret. application-prod.properties has no fallback — the app
# will refuse to start under the "prod" profile until you set a real one.
JWT_SECRET=changeThisToARandomLongStringInProduction
FRONTEND_URL=http://localhost:5173

# Bootstrap Admin account — only used the very first time the app starts with
# an empty users table. Set these before first boot so you're not left with
# the documented admin@medistock.com / Admin@123 default.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- OAuth2 Google login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email alerts (JavaMailSender) ---
EMAIL_ALERTS_ENABLED=false
EMAIL_ALERTS_RECIPIENTS=
MAIL_USERNAME=
MAIL_PASSWORD=
