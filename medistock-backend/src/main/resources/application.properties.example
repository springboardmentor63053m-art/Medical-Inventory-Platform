# ============================================================
# application.properties.example
# Copy this file to application.properties and fill in values.
# application.properties is gitignored — never commit real passwords.
# ============================================================

# Database Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/medistock
spring.datasource.username=postgres
spring.datasource.password=YOUR_POSTGRES_PASSWORD_HERE

spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Server Configuration
server.port=8080

# JWT Settings (Optional Customization)
# jwt.secret=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# jwt.expiration=86400000

# Inventory Settings
inventory.near-expiry-days=30
