<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#faf5ff"/>
      <stop offset="100%" stop-color="#e9d5ff"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="10" stdDeviation="8" flood-color="#581c87" flood-opacity="0.2"/>
    </filter>
  </defs>
  <rect width="400" height="300" rx="24" fill="url(#bg)"/>
  <g filter="url(#shadow)" transform="translate(60, 40)">
    <rect x="0" y="0" width="280" height="180" rx="16" fill="#ffffff" stroke="#9333ea" stroke-width="4"/>
    <rect x="0" y="0" width="280" height="45" rx="16" fill="#9333ea"/>
    <rect x="0" y="25" width="280" height="20" fill="#9333ea"/>
    <text x="20" y="30" font-family="system-ui, sans-serif" font-size="18" font-weight="900" fill="#ffffff" letter-spacing="1">METFORMIN 500 MG</text>
    <text x="20" y="75" font-family="system-ui, sans-serif" font-size="14" font-weight="700" fill="#1e293b">Antidiabetic Agent</text>
    <text x="20" y="95" font-family="system-ui, sans-serif" font-size="11" font-weight="500" fill="#64748b">14 Sustained Release Tablets</text>
    
    <rect x="20" y="115" width="60" height="36" rx="8" fill="#f3e8ff"/>
    <text x="50" y="139" font-family="system-ui, sans-serif" font-size="16" font-weight="900" fill="#7e22ce" text-anchor="middle">Rx</text>
    
    <rect x="180" y="110" width="80" height="45" rx="10" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="2"/>
    <circle cx="205" cy="132" r="10" fill="#9333ea"/>
    <circle cx="235" cy="132" r="10" fill="#9333ea"/>
  </g>
</svg>
