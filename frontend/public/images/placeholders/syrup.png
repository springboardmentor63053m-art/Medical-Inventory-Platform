<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fffbeb"/>
      <stop offset="50%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#fef3c7"/>
    </linearGradient>
    <linearGradient id="bottleGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#d97706"/>
      <stop offset="100%" stop-color="#b45309"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#78350f" flood-opacity="0.15"/>
    </filter>
  </defs>
  <rect width="400" height="300" rx="24" fill="url(#bg)"/>
  <g filter="url(#shadow)" transform="translate(150, 45)">
    <!-- Syrup Bottle Illustration -->
    <rect x="30" y="20" width="40" height="15" rx="4" fill="#78350f"/>
    <rect x="25" y="35" width="50" height="20" rx="6" fill="#92400e"/>
    <rect x="15" y="55" width="70" height="110" rx="14" fill="url(#bottleGrad)"/>
    <rect x="25" y="75" width="50" height="65" rx="6" fill="#ffffff" opacity="0.9"/>
    <line x1="35" y1="95" x2="65" y2="95" stroke="#d97706" stroke-width="4" stroke-linecap="round"/>
    <line x1="35" y1="110" x2="55" y2="110" stroke="#d97706" stroke-width="4" stroke-linecap="round"/>
  </g>
  <rect x="130" y="210" width="140" height="32" rx="16" fill="#92400e"/>
  <text x="200" y="231" font-family="system-ui, sans-serif" font-size="13" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">SYRUP</text>
</svg>
