<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#eff6ff"/>
      <stop offset="50%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#dbeafe"/>
    </linearGradient>
    <linearGradient id="pillGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#1d4ed8"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#1e3a8a" flood-opacity="0.15"/>
    </filter>
  </defs>
  <rect width="400" height="300" rx="24" fill="url(#bg)"/>
  <g filter="url(#shadow)" transform="translate(100, 70)">
    <!-- Round Tablet Illustration -->
    <circle cx="100" cy="80" r="65" fill="url(#pillGrad)"/>
    <circle cx="100" cy="80" r="65" fill="none" stroke="#60a5fa" stroke-width="4" opacity="0.6"/>
    <line x1="60" y1="80" x2="140" y2="80" stroke="#ffffff" stroke-width="5" stroke-linecap="round" opacity="0.8"/>
  </g>
  <rect x="130" y="210" width="140" height="32" rx="16" fill="#1e40af"/>
  <text x="200" y="231" font-family="system-ui, sans-serif" font-size="13" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">TABLET</text>
</svg>
