<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ecfdf5"/>
      <stop offset="50%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#d1fae5"/>
    </linearGradient>
    <linearGradient id="vialGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#059669"/>
      <stop offset="100%" stop-color="#047857"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#065f46" flood-opacity="0.15"/>
    </filter>
  </defs>
  <rect width="400" height="300" rx="24" fill="url(#bg)"/>
  <g filter="url(#shadow)" transform="translate(145, 45)">
    <!-- Injection Vial & Cap -->
    <rect x="35" y="20" width="40" height="12" rx="4" fill="#047857"/>
    <rect x="40" y="32" width="30" height="15" fill="#10b981"/>
    <rect x="20" y="47" width="70" height="115" rx="14" fill="url(#vialGrad)"/>
    <rect x="30" y="65" width="50" height="75" rx="6" fill="#ffffff" opacity="0.9"/>
    <circle cx="55" cy="100" r="16" fill="#ecfdf5"/>
    <path d="M55 90 L55 110 M45 100 L65 100" stroke="#059669" stroke-width="4" stroke-linecap="round"/>
  </g>
  <rect x="130" y="210" width="140" height="32" rx="16" fill="#047857"/>
  <text x="200" y="231" font-family="system-ui, sans-serif" font-size="13" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">INJECTION</text>
</svg>
