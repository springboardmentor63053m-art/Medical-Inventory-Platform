<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f1f5f9"/>
      <stop offset="50%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#e2e8f0"/>
    </linearGradient>
    <linearGradient id="defGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#475569"/>
      <stop offset="100%" stop-color="#334155"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#0f172a" flood-opacity="0.15"/>
    </filter>
  </defs>
  <rect width="400" height="300" rx="24" fill="url(#bg)"/>
  <g filter="url(#shadow)" transform="translate(150, 45)">
    <!-- Generic Pharmaceutical Bottle -->
    <rect x="30" y="20" width="40" height="15" rx="4" fill="#1e293b"/>
    <rect x="25" y="35" width="50" height="20" rx="6" fill="#334155"/>
    <rect x="15" y="55" width="70" height="110" rx="14" fill="url(#defGrad)"/>
    <rect x="25" y="75" width="50" height="65" rx="6" fill="#ffffff" opacity="0.9"/>
    <circle cx="50" cy="107" r="14" fill="#e2e8f0"/>
    <path d="M50 99 L50 115 M42 107 L58 107" stroke="#475569" stroke-width="3.5" stroke-linecap="round"/>
  </g>
  <rect x="130" y="210" width="140" height="32" rx="16" fill="#334155"/>
  <text x="200" y="231" font-family="system-ui, sans-serif" font-size="13" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">MEDICINE</text>
</svg>
