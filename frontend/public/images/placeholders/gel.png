<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fae8ff"/>
      <stop offset="50%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#f5d0fe"/>
    </linearGradient>
    <linearGradient id="gelGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#c026d3"/>
      <stop offset="100%" stop-color="#a21caf"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#701a75" flood-opacity="0.15"/>
    </filter>
  </defs>
  <rect width="400" height="300" rx="24" fill="url(#bg)"/>
  <g filter="url(#shadow)" transform="translate(130, 45)">
    <!-- Gel Tube -->
    <rect x="35" y="20" width="30" height="20" rx="4" fill="#701a75"/>
    <path d="M 30 40 L 70 40 L 85 150 L 15 150 Z" fill="url(#gelGrad)"/>
    <rect x="30" y="70" width="40" height="50" rx="6" fill="#ffffff" opacity="0.9"/>
  </g>
  <rect x="130" y="210" width="140" height="32" rx="16" fill="#a21caf"/>
  <text x="200" y="231" font-family="system-ui, sans-serif" font-size="13" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">GEL</text>
</svg>
