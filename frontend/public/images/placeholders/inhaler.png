<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f0fdf4"/>
      <stop offset="50%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#dcfce7"/>
    </linearGradient>
    <linearGradient id="inhalerGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0d9488"/>
      <stop offset="100%" stop-color="#0f766e"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#115e59" flood-opacity="0.15"/>
    </filter>
  </defs>
  <rect width="400" height="300" rx="24" fill="url(#bg)"/>
  <g filter="url(#shadow)" transform="translate(130, 45)">
    <!-- Inhaler Body -->
    <rect x="50" y="20" width="50" height="80" rx="10" fill="#115e59"/>
    <path d="M 50 80 L 100 80 L 110 140 C 110 155 90 160 50 160 C 20 160 20 140 30 120 L 50 80 Z" fill="url(#inhalerGrad)"/>
    <rect x="25" y="125" width="40" height="25" rx="8" fill="#14b8a6"/>
  </g>
  <rect x="130" y="210" width="140" height="32" rx="16" fill="#0f766e"/>
  <text x="200" y="231" font-family="system-ui, sans-serif" font-size="13" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">INHALER</text>
</svg>
