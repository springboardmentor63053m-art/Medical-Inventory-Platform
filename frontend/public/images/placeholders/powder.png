<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#eef2ff"/>
      <stop offset="50%" stop-color="#f8fafc"/>
      <stop offset="100%" stop-color="#e0e7ff"/>
    </linearGradient>
    <linearGradient id="sachetGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4f46e5"/>
      <stop offset="100%" stop-color="#3730a3"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#312e81" flood-opacity="0.15"/>
    </filter>
  </defs>
  <rect width="400" height="300" rx="24" fill="url(#bg)"/>
  <g filter="url(#shadow)" transform="translate(130, 45)">
    <!-- Powder Sachet -->
    <rect x="20" y="30" width="100" height="130" rx="8" fill="url(#sachetGrad)"/>
    <line x1="20" y1="45" x2="120" y2="45" stroke="#ffffff" stroke-width="2" stroke-dasharray="4,4"/>
    <rect x="35" y="65" width="70" height="70" rx="6" fill="#ffffff" opacity="0.9"/>
    <circle cx="70" cy="100" r="16" fill="#e0e7ff"/>
  </g>
  <rect x="130" y="210" width="140" height="32" rx="16" fill="#3730a3"/>
  <text x="200" y="231" font-family="system-ui, sans-serif" font-size="13" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="1.5">POWDER</text>
</svg>
